    // ── Persistent Cache of Recent Emojis ──────────────────────────────────
    Process {
        id: loadRecentProc
        command: ["cat", homeDir + "/.cache/quickshell/recent_emojis.json"]
        stdout: SplitParser {
            onRead: (data) => {
                try {
                    const parsed = JSON.parse(data)
                    if (Array.isArray(parsed)) {
                        root.recentEmojis = parsed
                    }
                } catch (e) {}
            }
        }
    }

    Process { id: saveRecentProc }
    Process { id: useProc }

    Component.onCompleted: {
        loadRecentProc.running = true
    }

    function saveRecent() {
        try {
            const jsonStr = JSON.stringify(recentEmojis)
            saveRecentProc.command = ["sh", "-c", "mkdir -p ~/.cache/quickshell && echo '" + jsonStr.replace(/'/g, "'\''") + "' > ~/.cache/quickshell/recent_emojis.json"]
            saveRecentProc.running = true
        } catch (e) {}
    }

    function recordUsage(emojiObj) {
        if (!emojiObj || !emojiObj.emoji) return
        const char = emojiObj.emoji
        const filtered = root.recentEmojis.filter(e => e.emoji !== char)
        filtered.unshift(emojiObj)
        root.recentEmojis = filtered.slice(0, 30)
        saveRecent()
    }

    // ── Optimized Search & Filter ───────────────────────────────────────────
    function search(query) {
        const rawQ = (query || "").trim().toLowerCase()
        if (rawQ.length === 0) {
            if (root.recentEmojis.length > 0) {
                const recentChars = new Set(root.recentEmojis.map(e => e.emoji))
                const remaining = database.filter(e => !recentChars.has(e.emoji))
                return root.recentEmojis.concat(remaining)
            }
            return database
        }

        const terms = rawQ.split(/\s+/).filter(t => t.length > 0)
        const matches = []
        const dLen = database.length

        for (let i = 0; i < dLen; i++) {
            const item = database[i]
            const char = item.emoji

            if (char === rawQ) {
                matches.push({ item: item, score: 1000 })
                continue
            }

            const nameLower = item.name.toLowerCase()
            const tagsLower = item.tags.toLowerCase()
            const catLower = item.category.toLowerCase()

            let score = 0
            let allMatch = true

            for (let t = 0; t < terms.length; t++) {
                const term = terms[t]
                if (nameLower.startsWith(term)) {
                    score += 200
                } else if (nameLower.indexOf(term) !== -1) {
                    score += 100
                } else if (tagsLower.indexOf(term) !== -1) {
                    score += 50
                } else if (catLower.indexOf(term) !== -1) {
                    score += 20
                } else {
                    allMatch = false
                    break
                }
            }

            if (allMatch && score > 0) {
                if (root.recentEmojis.some(r => r.emoji === item.emoji)) {
                    score += 150
                }
                matches.push({ item: item, score: score })
            }
        }

        matches.sort((a, b) => b.score - a.score)
        return matches.map(m => m.item)
    }

    // ── Use / Insert Emoji Immediately (Direct Typing & Clipboard) ──────────
    function insert(emojiItem) {
        if (!emojiItem) return
        const char = typeof emojiItem === "string" ? emojiItem : (emojiItem.emoji || "")
        const name = typeof emojiItem === "string" ? "Emoji" : (emojiItem.name || "Emoji")
        if (!char) return

        recordUsage(typeof emojiItem === "string" ? { emoji: char, name: name } : emojiItem)

        // Run direct typing + clipboard copy in background
        const wtypeBin = homeDir + "/.local/bin/wtype"
        const cmd = "wl-copy '" + char + "' 2>/dev/null; sleep 0.08; (" + wtypeBin + " '" + char + "' || wtype '" + char + "' || ydotool type '" + char + "') 2>/dev/null || true"
        useProc.command = ["sh", "-c", cmd]
        useProc.running = true

        if (Services.SoundFeedback) {
            Services.SoundFeedback.playInfo()
        }
    }

    // Alias copy to insert for compatibility
    function copy(emojiItem) {
        insert(emojiItem)
    }
